# EditorConfig - https://editorconfig.org
root = true

# Configuração global
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Terraform
[*.tf]
indent_size = 2

[*.tfvars]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false

# YAML (GitHub Actions)
[*.{yml,yaml}]
indent_size = 2

# JSON
[*.json]
indent_size = 2

# Shell scripts
[*.sh]
indent_size = 2

# Makefiles precisam de tabs
[Makefile]
indent_style = tab
