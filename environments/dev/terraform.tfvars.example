# ==============================================================================
# EXEMPLO DE VARIÁVEIS - AMBIENTE DEV
# ==============================================================================
# Copie este arquivo para terraform.tfvars e ajuste os valores:
#   cp terraform.tfvars.example terraform.tfvars
# ==============================================================================

# Nome do projeto (usado em naming conventions)
project_name = "meulab"

# Ambiente de deploy (dev, staging, prod)
environment = "dev"

# Região Azure para deploy dos recursos
# Recomendadas para Free Tier: eastus, eastus2, westus2, brazilsouth
location = "brazilsouth"

# Número de VMs a serem criadas
# Free Tier: 1 VM B1s gratuita por 12 meses
vm_count = 1

# Email do responsável pelo projeto
owner = "seu-email@exemplo.com"

# Tier da Storage Account (Standard ou Premium)
# Free Tier: Standard (5GB gratuitos)
storage_account_tier = "Standard"

# Tipo de replicação da Storage Account
# LRS = Locally Redundant (mais barato, ideal para dev)
# GRS = Geo-Redundant (staging/prod)
# ZRS = Zone-Redundant (alta disponibilidade)
storage_replication_type = "LRS"
